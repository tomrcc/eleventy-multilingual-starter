{%- comment -%}
  The key goes on a span wrapping only the label, not on the <a>. Rosey captures
  an element's whole innerHTML, so a key on the link would swallow the icon
  markup and re-inject it alongside the template's own copy on translated pages.
  Buttons carry their own `_uuid` because one block can hold several.
{%- endcomment -%}
<button data-rosey-ns="{{ _uuid }}" style="--hover_brightness: {{ hover_brightness }}; background-color: {{background_color}}" class="button">
  <a style="color: {{text_color}}" href="{{ button_link | localizeUrl: locale }}">
    {% if button_icon %}
      <span class="button__icon">
        {% include "components/icon", icon: button_icon %}
      </span>
    {% endif %}
    <span data-rosey="button_text">{{ button_text }}</span>
  </a>
</button>
