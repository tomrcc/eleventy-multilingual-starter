{%- comment -%}
  The key wraps only the label, keeping icon markup out of the translated
  value. See buttons/primary.liquid.
{%- endcomment -%}
<button
  data-rosey-ns="{{ _uuid }}"
  style="--hover_brightness: {{ hover_brightness }}; background-color: transparent; border: 2px solid {{text_color}}"
  class="button">
  <a style="color: {{text_color}}" href="{{ button_link | localizeUrl: locale }}">
    {% if button_icon %}
      <span class="button__icon">
        {% include "components/icon", icon: button_icon %}
      </span>
    {% endif %}
    <span data-rosey="button_text">{{ button_text }}</span>
  </a>
</button>
